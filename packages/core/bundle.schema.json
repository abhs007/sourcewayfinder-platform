{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sourcewayfinder:bundle:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "usage": {
      "enum": ["test_fixture", "production_candidate"]
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "entryQuestionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": ["id", "label"]
            }
          },
          "help": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": ["id", "prompt", "choices"]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "choiceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "targetType": {
            "enum": ["question", "outcome"]
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required": ["questionId", "choiceId", "targetType", "targetId"]
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "nextStep": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            },
            "maxItems": 30
          }
        },
        "required": ["id", "title", "nextStep", "unresolved", "sourceRefs"]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "sourceVersionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "snapshotSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "passage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "title": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": ["id", "sourceVersionId", "snapshotSha256", "url", "passage"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "usage",
    "flowId",
    "scope",
    "entryQuestionId",
    "questions",
    "transitions",
    "outcomes",
    "sources"
  ]
}
