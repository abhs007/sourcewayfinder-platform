{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "workers/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "ops/**/*.mts"
  ],
  "exclude": ["private", "node_modules", "dist"]
}
