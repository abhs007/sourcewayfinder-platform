{
  "account_id": "a03d9f71f863eed1dc764ca7d4e34c49",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "name": "sourcewayfinder-staging-api",
  "main": "../../dist/workers/api.mjs",
  "vars": {
    "ENVIRONMENT": "staging",
    "PUBLIC_ORIGIN": "https://staging.sourcewayfinder.org"
  },
  "services": [
    {
      "binding": "CONTENT",
      "service": "sourcewayfinder-staging-control",
      "entrypoint": "PublishedContent"
    }
  ],
  "d1_databases": [
    {
      "binding": "SESSIONS_DB",
      "database_name": "sourcewayfinder-staging-sessions",
      "database_id": "c529829b-2b21-46b5-bbee-665c6221961a",
      "migrations_dir": "../../workers/api/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "GUIDANCE_LIMITER",
      "namespace_id": "7391123",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": []
  }
}
